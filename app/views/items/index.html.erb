<div class="mb-8 grid grid-cols-1 md:grid-cols-3 gap-6">
  <div class="bg-white overflow-hidden shadow rounded-lg px-4 py-5 sm:p-6 border-l-4 border-indigo-500">
    <dt class="text-sm font-medium text-gray-500 truncate">コレクション総数</dt>
    <dd class="mt-1 text-3xl font-semibold text-gray-900"><%= @items.count %> <span class="text-sm font-normal text-gray-500">点</span></dd>
  </div>
  <div class="bg-white overflow-hidden shadow rounded-lg px-4 py-5 sm:p-6 border-l-4 border-green-500">
    <dt class="text-sm font-medium text-gray-500 truncate">推定資産総額</dt>
    <dd class="mt-1 text-3xl font-semibold text-gray-900">
      ¥<%= number_with_delimiter(@items.sum { |i| i.current_market_price.to_i }) %>
    </dd>
  </div>
</div>

<div class="flex justify-between items-center mb-6">
  <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate">あなたのコレクション</h2>
</div>

<div id="items" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
  <% @items.each do |item| %>
    <%= render item %>
  <% end %>
</div>