<% content_for :title, "アイテム詳細" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">アイテム詳細</h1>

  <%= render @item %>

  <%= link_to "編集", edit_item_path(@item), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-orange-100 hover:bg-orange-50 inline-block font-medium text-black" %>
  <%= link_to "戻る", items_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-lime-100 hover:bg-lime-50 inline-block font-medium text-black" %>
  <%= button_to "削除", @item, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "本当に削除しますか？" } %>
</div>
