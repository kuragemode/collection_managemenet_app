<div id="<%= dom_id item %>" class="group relative bg-slate-800/50 border border-white/5 rounded-2xl overflow-hidden hover:bg-slate-800 transition duration-300 hover:shadow-2xl hover:shadow-indigo-500/10 hover:-translate-y-1">
  
  <div class="aspect-square w-full overflow-hidden bg-slate-900 relative">
    <% if item.image.attached? %>
      <%= image_tag item.image.variant(resize_to_fill: [600, 600]), class: "w-full h-full object-cover group-hover:scale-110 transition duration-500" %>
    <% else %>
      <div class="flex items-center justify-center h-full text-slate-700">
        <span class="text-6xl">📷</span>
      </div>
    <% end %>

    <div class="absolute top-3 right-3 bg-black/60 backdrop-blur-sm px-3 py-1 rounded-full border border-white/10">
      <span class="text-xs text-slate-300">現在相場</span>
      <span class="font-bold text-emerald-400 ml-1">¥<%= number_with_delimiter(item.current_market_price) rescue "---" %></span>
    </div>
  </div>

  <div class="p-5">
    <h3 class="text-lg font-bold text-white mb-1 truncate tracking-tight">
      <%= link_to item.name, item, class: "after:absolute after:inset-0" %></h3>
    
    <div class="flex justify-between items-end mt-4">
      <div>
        <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">購入価格</p>
        <p class="text-sm font-medium text-slate-300">¥<%= number_with_delimiter(item.purchase_price) rescue 0 %></p>
      </div>
      
      <% profit = (item.current_market_price.to_i - item.purchase_price.to_i) rescue 0 %>
      <div class="text-right">
        <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">損益</p>
        <p class="text-sm font-bold <%= profit >= 0 ? 'text-emerald-400' : 'text-rose-400' %>">
          <%= profit >= 0 ? "+" : "" %>¥<%= number_with_delimiter(profit) %>
        </p>
      </div>
    </div>
  </div>
</div>