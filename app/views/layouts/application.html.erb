<!DOCTYPE html>
<html>
  <head>
    <title>Myapp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900 font-sans antialiased">
    <div class="flex items-center space-x-4">
          <% if user_signed_in? %>
            <span class="text-sm text-gray-500 hidden sm:block">Logged in as <strong><%= current_user.email %></strong></span>
            
            <%= link_to "アイテム登録", new_item_path, class: "px-4 py-2 rounded-md text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 transition" %>
            
            <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-sm text-gray-500 hover:text-gray-900" %>
          <% else %>
            <%= link_to "ログイン", new_user_session_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
            <%= link_to "新規登録", new_user_registration_path, class: "ml-4 text-sm font-medium text-gray-500 hover:text-gray-900" %>
          <% end %>
        </div>

    <main class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
      <% flash.each do |key, value| %>
        <div class="mb-4 p-4 rounded-md <%= key == 'notice' ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700' %>">
          <%= value %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
