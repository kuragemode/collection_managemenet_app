<!DOCTYPE html>
<html>
  <head>
    <title>MyCollection | デジタルショールーム</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">

    <%= javascript_importmap_tags %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    
    <style>
      body { font-family: 'Inter', sans-serif; }
    </style>
  </head>

  <body class="bg-slate-900 min-h-screen text-slate-100 antialiased selection:bg-indigo-500 selection:text-white">
    
    <nav class="fixed w-full z-50 top-0 start-0 border-b border-white/10 bg-slate-900/80 backdrop-blur-md">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between mx-auto p-4">
        <a href="/" class="flex items-center space-x-3 rtl:space-x-reverse">
          <span class="self-center text-2xl font-black whitespace-nowrap bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-cyan-400">
            MY COLLECTION
          </span>
        </a>
        <div class="flex md:order-2 space-x-3 md:space-x-0 rtl:space-x-reverse">
          <% if user_signed_in? %>
             <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "mr-3 text-white bg-indigo-600 hover:bg-indigo-700 font-medium rounded-lg text-sm px-4 py-2" %>
             <%= link_to "＋ 追加する", new_item_path, class: "text-white bg-indigo-600 hover:bg-indigo-700 focus:ring-4 focus:outline-none focus:ring-indigo-800 font-medium rounded-lg text-sm px-4 py-2 text-center" %>
          <% else %>
             <%= link_to "ログイン", new_user_session_path, class: "text-white bg-indigo-600 hover:bg-indigo-700 font-medium rounded-lg text-sm px-4 py-2" %>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="max-w-7xl mx-auto pt-24 pb-10 px-4">
      <% flash.each do |key, value| %>
        <div class="mb-6 p-4 rounded-lg bg-indigo-900/50 border border-indigo-500/50 text-indigo-100">
          <%= value %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>